# DeepSeek API
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# x402 — адрес кошелька для приёма USDC (публичный, приватный ключ НЕ нужен)
PAY_TO_ADDRESS_EVM=0xYourEVMWalletAddressHere
# PAY_TO_ADDRESS_SOLANA=  # опционально

# x402 Facilitator
FACILITATOR_URL=https://x402.org/facilitator

# Режим: true = Base Sepolia (тестнет), false = Base Mainnet
TESTNET=true
ENVIRONMENT=development
