# DeepSeek API
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# x402 — receiving wallet address for USDC (public, NO private key needed)
PAY_TO_ADDRESS_EVM=0xYourEVMWalletAddressHere

# x402 Facilitator mode: "direct" (Sovereign Mode, own RPC verification) or "cdp" (Coinbase CDP, agentic.market listing)
FACILITATOR_MODE=direct
FACILITATOR_URL=https://x402.dexter.cash

# CDP Facilitator credentials (only needed when FACILITATOR_MODE=cdp)
# Get from https://portal.cdp.coinbase.com → API Keys
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Mode: true = Base Sepolia (testnet), false = Base Mainnet
TESTNET=true
ENVIRONMENT=development
