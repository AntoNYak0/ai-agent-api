# DeepSeek API
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# x402 — receiving wallet address for USDC (public, NO private key needed)
PAY_TO_ADDRESS_EVM=0xYourEVMWalletAddressHere

# x402 Facilitator
FACILITATOR_URL=https://x402.org/facilitator

# Mode: true = Base Sepolia (testnet), false = Base Mainnet
TESTNET=true
ENVIRONMENT=development
